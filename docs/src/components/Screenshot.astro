---
// A screenshot taken in both themes. Only the one matching the reader's theme is shown, and the
// hidden one is never downloaded, because lazy images that are not displayed are not fetched.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
	/** File name in src/assets/screens without the -light.png or -dark.png suffix. */
	name: string;
	alt: string;
	caption?: string;
}
const { name, alt, caption } = Astro.props;
const shots = import.meta.glob<{ default: ImageMetadata }>('../assets/screens/*.png', { eager: true });
const pick = (scheme: 'light' | 'dark') => {
	const shot = shots[`../assets/screens/${name}-${scheme}.png`];
	if (!shot) throw new Error(`no screenshot ${name}-${scheme}.png: run docs/scripts/screenshots.mjs`);
	return shot.default;
};
const common = { alt, widths: [800, 1360, 2040], sizes: '(min-width: 72rem) 52rem, 100vw', loading: 'lazy' } as const;
---

<figure class="shot not-content">
	<Image src={pick('light')} class="shot-light" {...common} />
	<Image src={pick('dark')} class="shot-dark" {...common} />
	{caption && <figcaption>{caption}</figcaption>}
</figure>
